<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{site.data.config.description}}">
  <meta name="color-scheme" content="light">
  <title>{% if page.attrs.kind != 'home' %}{{page.title}} · {% endif %}{{site.title}}</title>
  <link rel="icon" type="image/jpeg" href="{{url(path='avatar.jpg')}}">
  <link rel="stylesheet" href="{{url(path='css/uno.css')}}">
  <link rel="stylesheet" href="{{url(path='main.css')}}">
  <link rel="stylesheet" href="{{assets.highlight}}">
  <script type="module" src="{{url(path='site.js')}}"></script>
  {% if assets.components %}<script type="module" src="{{assets.components}}"></script>{% endif %}
</head>
<body data-kind="{{page.attrs.kind}}">
  <svg class="icon-sprite" aria-hidden="true"><defs>
    <symbol id="github" viewBox="0 0 496 512"><path d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6c-3.3.3-5.6-1.3-5.6-3.6c0-2 2.3-3.6 5.2-3.6c3-.3 5.6 1.3 5.6 3.6m-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9c2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5.3-6.2 2.3m44.2-1.7c-2.9.7-4.9 2.6-4.6 4.9c.3 2 2.9 3.3 5.9 2.6c2.9-.7 4.9-2.6 4.6-4.6c-.3-1.9-3-3.2-5.9-2.9M244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2c12.8 2.3 17.3-5.6 17.3-12.1c0-6.2-.3-40.4-.3-61.4c0 0-70 15-84.7-29.8c0 0-11.4-29.1-27.8-36.6c0 0-22.9-15.7 1.6-15.4c0 0 24.9 2 38.6 25.8c21.9 38.6 58.6 27.5 72.9 20.9c2.3-16 8.8-27.1 16-33.7c-55.9-6.2-112.3-14.3-112.3-110.5c0-27.5 7.6-41.3 23.6-58.9c-2.6-6.5-11.1-33.3 2.6-67.9c20.9-6.5 69 27 69 27c20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27c13.7 34.7 5.2 61.4 2.6 67.9c16 17.7 25.8 31.5 25.8 58.9c0 96.5-58.9 104.2-114.8 110.5c9.2 7.9 17 22.9 17 46.4c0 33.7-.3 75.4-.3 83.6c0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252C496 113.3 383.5 8 244.8 8M97.2 352.9c-1.3 1-1 3.3.7 5.2c1.6 1.6 3.9 2.3 5.2 1c1.3-1 1-3.3-.7-5.2c-1.6-1.6-3.9-2.3-5.2-1m-10.8-8.1c-.7 1.3.3 2.9 2.3 3.9c1.6 1 3.6.7 4.3-.7c.7-1.3-.3-2.9-2.3-3.9c-2-.6-3.6-.3-4.3.7m32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2c2.3 2.3 5.2 2.6 6.5 1c1.3-1.3.7-4.3-1.3-6.2c-2.2-2.3-5.2-2.6-6.5-1m-11.4-14.7c-1.6 1-1.6 3.6 0 5.9s4.3 3.3 5.6 2.3c1.6-1.3 1.6-3.9 0-6.2c-1.4-2.3-4-3.3-5.6-2"/></symbol>
    <symbol id="bilibili" viewBox="0 0 24 24"><path d="m7 1 4 4h2l4-4 1.4 1.4L15.8 5H19a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h3.2L5.6 2.4ZM5 7v13h14V7Zm2 3h2v5H7Zm8 0h2v5h-2Z"/></symbol>
    <symbol id="steam" viewBox="0 0 24 24"><path d="M12 1a11 11 0 0 0-10.7 8.4l5.9 2.5a3.5 3.5 0 0 1 1.8-.5l2.8-4.1a4.8 4.8 0 1 1 4.8 4.8L12.5 15a3.6 3.6 0 0 1-7 1.1L1.2 14A11 11 0 1 0 12 1ZM8.8 13.1a2 2 0 1 0 1.5 2.6l-2.7-1.1.4-1Zm7.8-8.9a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6Z"/></symbol>
  </defs></svg>
  <header class="site-header">
    <div class="site-header-backdrop" aria-hidden="true"></div>
    <nav class="site-nav" aria-label="主导航">
      <a class="brand nav-btn" href="{{url(path='/')}}"><img src="{{url(path='avatar.jpg')}}" alt="Azur冰弦" width="32" height="32"><span><span class="brand-title">{{site.title}}</span><span class="brand-description">{{site.data.config.description}}</span></span></a>
      <a class="nav-btn" href="{{url(path='posts/')}}" {% if page.attrs.kind == 'posts' or page.attrs.kind == 'article' %}aria-current="page"{% endif %}>文章</a>
      <a class="nav-btn" href="{{url(path='gallery/')}}" {% if page.attrs.kind == 'gallery' or page.attrs.kind == 'gallery_index' %}aria-current="page"{% endif %}>画廊</a>
      <a class="nav-btn" href="{{url(path='search/')}}" {% if page.attrs.kind == 'search' %}aria-current="page"{% endif %}>搜索</a>
      <a class="nav-btn repository" href="{{site.data.config.repository}}" aria-label="GitHub 仓库" rel="noreferrer"><span class="icon repository-icon" aria-hidden="true"></span></a>
    </nav>
    <div class="scroll-progress" aria-hidden="true"><div class="scroll-progress-bar"></div></div><output class="scroll-progress-pill" aria-hidden="true">0%</output>
  </header>
  <main class="site-main {% if page.attrs.kind == 'gallery' or page.attrs.kind == 'gallery_index' %}gallery-main{% endif %}" id="main-content">
    {% if page.attrs.kind == 'home' %}
      <div class="hero"><img class="hero-avatar" src="{{url(path='avatar.jpg')}}" alt="Azur冰弦的头像" width="160" height="160"><div class="hero-info">
        <span class="hero-title">&lt; {{site.title}} /&gt;</span><span class="hero-description">{{site.data.config.description}}</span><span class="hero-email">📫 <a href="mailto:{{site.data.config.email}}">{{site.data.config.email}}</a></span>
        <div class="socials"><a href="{{site.data.config.github}}" aria-label="GitHub" target="_blank" rel="noreferrer"><svg class="icon"><use href="#github"></use></svg></a><a href="{{site.data.config.bilibili}}" class="bilibili" aria-label="Bilibili" target="_blank" rel="noreferrer"><svg class="icon"><use href="#bilibili"></use></svg></a><a href="{{site.data.config.steam}}" class="steam" aria-label="Steam" target="_blank" rel="noreferrer"><svg class="icon"><use href="#steam"></use></svg></a></div>
      </div></div>
      <div class="markdown home-content"><h2>最新文章</h2><ul class="recent-posts">{% for post in site.data.blog.posts %}<li><time>{{post.created}}</time><a href="{{url(path=post.url)}}">{{post.title}}</a></li>{% endfor %}</ul><hr>{{page.html | safe}}</div>
    {% elif page.attrs.kind == 'posts' or page.attrs.kind == 'search' %}
      <h1 class="page-title">{{page.title}}</h1>
      {% if page.attrs.kind == 'search' %}<label class="search-field" for="search-input">搜索文章标题和正文<input id="search-input" type="search" placeholder="输入关键词…" autocomplete="off"></label><p id="search-status" role="status">共 {{site.data.blog.posts | length}} 篇文章</p>{% endif %}
      <div class="posts-list">{% for post in site.data.blog.posts %}<article class="post-card" {% if page.attrs.kind == 'search' %}data-search-text="{{post.search}}"{% endif %}><a href="{{url(path=post.url)}}"><h2>{{post.title}}</h2></a><div class="post-dates"><span>创建日期: {{post.created}}</span><span>更新日期: {{post.updated}}</span></div><div class="summary">{{post.summary_html | safe}}</div></article>{% endfor %}</div>
    {% elif page.attrs.kind == 'gallery' or page.attrs.kind == 'gallery_index' %}
      <div class="gallery-page"><h1 class="gallery-page-title">Gallery</h1><nav class="gallery-tabs" aria-label="相册分类">{% for category in site.data.blog.categories %}<a class="gallery-tab {% if page.attrs.category == category.name or page.attrs.kind == 'gallery_index' and loop.first %}active{% endif %}" href="{{url(path=category.url)}}">{{category.name}}<span class="gallery-tab-count">{{category.count}}</span></a>{% endfor %}</nav>
      {% for category in site.data.blog.categories %}{% if page.attrs.category == category.name or page.attrs.kind == 'gallery_index' and loop.first %}
        <section class="gallery-category" aria-label="{{category.name}}">
          {% if page.attrs.kind == 'gallery' %}<div class="gallery-category-desc markdown">{{page.html | safe}}</div>{% endif %}
          <div class="gallery-tabs gallery-years" role="group" aria-label="拍摄年份">{% for year in category.years %}<button class="gallery-tab year-tab" type="button" data-year="{{year.name}}" aria-pressed="false">{{year.name}}<span class="gallery-tab-count">{{year.count}}</span></button>{% endfor %}</div>
          <div class="gallery-timeline">{% for date in category.timeline %}<section class="gallery-date-group" data-year="{{date.year}}"><h2 class="gallery-date-heading">{{date.display}}</h2><div class="gallery-date-content">
            {% for group in date.groups %}<div class="{% if group.name %}gallery-folder-group{% endif %}">{% if group.name %}<div class="gallery-folder-header"><h3 class="gallery-folder-heading">{{group.name}}</h3>{% if group.description_path %}{% for other in site.pages %}{% if other.route.path == group.description_path %}<div class="gallery-folder-desc markdown">{{other.html | safe}}</div>{% endif %}{% endfor %}{% endif %}</div>{% endif %}
              <div class="gallery-layout">{% for image in group.images %}<button class="gallery-card gallery-card-rating-{{image.rating}} {% if image.label == 'Red' %}gallery-card-feature{% endif %}" type="button" aria-label="查看 {{image.title}}" data-src="{{image.src}}" data-width="{{image.width}}" data-height="{{image.height}}" data-title="{{image.title}}" data-description="{{image.description}}" data-rating="{{image.rating}}" data-label="{{image.label}}" data-created="{{image.created}}"><img class="gallery-thumb" src="{{image.src}}" alt="{{image.title}}" width="{{image.width}}" height="{{image.height}}" loading="lazy" decoding="async"><span class="gallery-overlay"><span class="gallery-title">{{image.title}}</span></span></button>{% endfor %}</div>
            </div>{% endfor %}
          </div></section>{% endfor %}</div>
        </section>
      {% endif %}{% endfor %}</div>
    {% elif page.attrs.kind == 'not_found' %}
      <div class="not-found"><h1>404</h1><p>页面未找到</p><a href="{{url(path='/')}}">返回首页</a></div>
    {% else %}
      <article class="markdown article-content">{{page.html | safe}}</article>
    {% endif %}
  </main>
  <button class="scroll-top" type="button" aria-label="返回顶部" title="返回顶部"><svg class="scroll-top-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 7-7 7 7M12 19V5"/></svg></button>
  {% if page.attrs.comment_path or page.attrs.kind == 'gallery_index' %}
    <div class="comment-overlay-backdrop" hidden></div><aside class="comment-overlay" aria-label="评论">
      <button class="comment-overlay-bar" type="button" aria-expanded="false" aria-controls="comment-panel"><span class="comment-overlay-title">评论 <span class="comment-overlay-path">{% if page.attrs.comment_path %}{{page.attrs.comment_path}}{% else %}/gallery/{% endif %}</span></span><span class="comment-overlay-chevron" aria-hidden="true">↑</span></button>
      <div class="comment-overlay-panel" id="comment-panel" inert><div class="comment-overlay-content"><div id="waline" data-server="{{site.data.config.waline_server}}" data-path="{% if page.attrs.comment_path %}{{page.attrs.comment_path}}{% else %}/gallery/{% endif %}"></div><p id="comment-error" role="status" hidden>评论加载失败，请稍后重试。<button type="button" id="retry-comments">重试</button></p></div></div>
    </aside>
  {% endif %}
  <dialog class="gallery-lightbox" id="lightbox" aria-label="图片预览"><button class="gallery-lightbox-close" type="button" aria-label="关闭图片预览">×</button><button class="gallery-lightbox-prev" type="button" aria-label="上一张">‹</button><div class="gallery-lightbox-content"><img class="gallery-lightbox-img" alt=""><p class="gallery-lightbox-title"></p><div class="gallery-lightbox-meta"><span class="gallery-lightbox-rating"></span><span class="gallery-lightbox-label"></span><time></time></div><p class="gallery-lightbox-desc"></p><output class="gallery-lightbox-counter"></output></div><button class="gallery-lightbox-next" type="button" aria-label="下一张">›</button></dialog>
</body>
</html>
